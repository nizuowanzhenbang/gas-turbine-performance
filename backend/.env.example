# --- 数据库 -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://gtp:gtp@postgres:5432/gtp

# --- JWT ----------------------------------------------------------------
JWT_SECRET=please-change-me-32bytes-minimum-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=["*"]

# --- 跨系统集成 ---------------------------------------------------------
INTEGRATION_SECRET=gtp-integration-shared-secret-change-me
INTEGRATION_TIMEOUT=3.0
INTEGRATION_RETRIES=2

FUEL_METERING_BASE_URL=http://gas-fuel-metering-backend:8010
EQUIPMENT_INSPECTION_BASE_URL=http://equipment-inspection-backend:8005
PLANT_SAFETY_BASE_URL=http://plant-safety-backend:8002
FUEL_PROCUREMENT_BASE_URL=http://fuel-procurement-backend:8003
EMISSION_MONITORING_BASE_URL=http://emission-monitoring-backend:8007

# --- 调度器 -------------------------------------------------------------
SCHEDULER_ENABLED=true
PERF_CALC_INTERVAL_MINUTES=1
VIBRATION_CHECK_INTERVAL_MINUTES=5
DEGRADATION_DAILY_HOUR=2
